	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ClinicAdapter"/>
	<queryString language="SQL">
		<![CDATA[SELECT p.p_name, d.d_name,  v.visit_date, EXTRACT(HOUR FROM v.visit_date) AS visit_hour, EXTRACT(MINUTE FROM v.visit_date) AS visit_minute, i.icd_name
FROM visit v
JOIN patient p ON v.p_id = p.p_id
JOIN doctor d ON v.d_id = d.d_id
JOIN icd_10 i ON v.icd_code = i.icd_code
WHERE v.visit_date >= TRUNC(SYSDATE) - 30 AND v.icd_code != '0000'
ORDER BY v.visit_date DESC]]>
	</queryString>
